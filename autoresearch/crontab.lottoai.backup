# LottAI — run prediction pipeline after each TX Pick 3 draw (Mon-Sat, CT)
# Morning draw 10:00 AM → run 10:27 AM
27 10 * * 1-6  /mnt/beastmode/lottai/autoresearch/run_prediction.sh
# Day draw 12:27 PM → run 12:57 PM
57 12 * * 1-6  /mnt/beastmode/lottai/autoresearch/run_prediction.sh
# Evening draw 6:00 PM → run 6:30 PM
30 18 * * 1-6  /mnt/beastmode/lottai/autoresearch/run_prediction.sh
# Night draw 10:12 PM → run 10:42 PM
42 22 * * 1-6  /mnt/beastmode/lottai/autoresearch/run_prediction.sh
